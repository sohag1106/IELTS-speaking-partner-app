# Neon (or local Postgres) connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

PORT=3001

# Part 2 timing (seconds)
PART2_PREP_SECONDS=60
PART2_TALK_SECONDS=120

# ICE — Google STUN is the default. Mixed networks (mobile data ↔ Wi-Fi) need
# a TURN relay; pick ONE of the two options:
#
# 1) Cloudflare TURN (recommended, 1000 GB/mo free):
#    dash.cloudflare.com → Realtime → TURN Server → Create
# CF_TURN_KEY_ID=
# CF_TURN_TOKEN=
#
# 2) A static TURN server (coturn / hosted TURN):
# STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
